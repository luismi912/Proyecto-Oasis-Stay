        <mxCell id="comp_reservas" value="&lt;b&gt;GestionReservas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[Component: C# / App Service]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Coordina creación, edición y cancelación de reservas; valida fechas y datos de huésped." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#5C95D1;strokeColor=#3A6899;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
