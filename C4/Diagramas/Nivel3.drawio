        </mxCell>
        
        <mxCell id="comp_cuentas" value="&lt;b&gt;MotorCuentasFacturacion&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[Component: C# / Domain Service]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Calcula cotizaciones, consumos, IVA 19% (RN-03), recargo late check-out (RN-04) y factura." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#5C95D1;strokeColor=#3A6899;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
