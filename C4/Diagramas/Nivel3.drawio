        <mxCell id="comp_auditoria" value="&lt;b&gt;AuditoriaHistorial&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[Component: C# / App Service]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Consulta eventos, reportes y trazabilidad por rango de fechas o clientes sin alterar datos." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#5C95D1;strokeColor=#3A6899;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
