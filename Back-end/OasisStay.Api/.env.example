# Secretos: usar `dotnet user-secrets` en Back-end/OasisStay.Api (no poner valores reales en el repositorio)
# dotnet user-secrets set "Jwt:Clave" "<cadena aleatoria de 32+ caracteres>" --project Back-end/OasisStay.Api
# dotnet user-secrets set "Seguridad:ClaveAes" "<32 bytes en Base64>" --project Back-end/OasisStay.Api
# dotnet user-secrets set "Semilla:Usuarios:Administrador:Contrasena" "<clave>" --project Back-end/OasisStay.Api
# dotnet user-secrets set "Semilla:Usuarios:Recepcionista:Contrasena" "<clave>" --project Back-end/OasisStay.Api
# dotnet user-secrets set "Semilla:Usuarios:AmaDeLlaves:Contrasena" "<clave>" --project Back-end/OasisStay.Api
Jwt__Clave=
Seguridad__ClaveAes=
Semilla__Usuarios__Administrador__Contrasena=
Semilla__Usuarios__Recepcionista__Contrasena=
Semilla__Usuarios__AmaDeLlaves__Contrasena=
