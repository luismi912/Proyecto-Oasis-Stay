@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var isLogin = currentPage == "/Index";
}
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Oasis Stay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap"
    rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>

<body class="@(isLogin ? "login-body" : "app-body")">
    @if (isLogin)
    {
        @RenderBody()
    }
    else
    {
        <div class="app-shell">
            <aside class="sidebar">
                <a class="brand" asp-page="/Index"><span class="brand-mark">O</span><span><b>Oasis</b> Stay</span></a>
                <nav class="sidebar-nav">
                    <span class="nav-label">Menú principal</span>
                    <a class="@(currentPage == "/Ventanas/PanelControl" ? "active" : "")"
                       asp-page="/Ventanas/PanelControl"><span>▦</span> Dashboard</a>
                    <a class="@(currentPage == "/Ventanas/Reservas" ? "active" : "")"
                       asp-page="/Ventanas/Reservas"><span>▣</span> Reservas <small>8</small></a>
                    <a class="@(currentPage == "/Ventanas/Habitaciones" ? "active" : "")"
                       asp-page="/Ventanas/Habitaciones"><span>▱</span> Habitaciones</a>
                    <a class="@(currentPage == "/Ventanas/Facturacion" ? "active" : "")"
                       asp-page="/Ventanas/Facturacion"><span>▤</span> Facturación</a>
                    <a class="@(currentPage == "/Ventanas/Historial" ? "active" : "")"
                       asp-page="/Ventanas/Historial"><span>◷</span> Historial</a>
                    <a class="@(currentPage == "/Ventanas/Configuracion" ? "active" : "")"
                       asp-page="/Ventanas/Configuracion"><span>⚙</span> Configuración</a>
                </nav>
                <div class="sidebar-bottom">
                    <div class="profile"><span class="avatar">CM</span><span><b>Camila
                        Mejía</b><small>Administrador</small></span></div>
                        <a class="logout" asp-page="/Index">↪ Cerrar sesión</a>
                        <small class="version">Oasis PMS · v2.4.0</small>
                    </div>
                </aside>
                <div class="app-main">
                    <header class="topbar">
                        <div>
                            <h1>@ViewData["Title"]</h1>
                            <p>@(ViewData["Subtitle"] ?? "Gestión simple. Experiencias memorables.")</p>
                        </div>
                        <div class="topbar-actions"><button class="circle-button">⌕</button><button
                            class="circle-button notification">♧</button><a class="primary-button"
                                                                            asp-page="/Ventanas/Reservas" asp-fragment="nueva-reserva">＋ Nueva reserva</a></div>
                        </header>
                        <main class="content">@RenderBody()</main>
                    </div>
                </div>
            }
            @await RenderSectionAsync("Scripts", required: false)
        </body>

    </html>
