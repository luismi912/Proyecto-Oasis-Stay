@page
@model ReservasModel
@{
    ViewData["Title"] = "Reservas";
    ViewData["Subtitle"] = "Gestiona las próximas estadías";
}

@functions {
    private string Err(string campo) => ViewData.ModelState.TryGetValue(campo, out var e) && e.Errors.Count > 0 ? " has-error" : "";
    private string Msg(string campo) => ViewData.ModelState.TryGetValue(campo, out var e) && e.Errors.Count > 0 ? e.Errors[0].ErrorMessage : "";
}
@if (TempData["ReservationSuccess"] is string reservationSuccess)
{
    <div class="toast success">✓ @reservationSuccess</div>
}
@if (TempData["ReservationError"] is string reservationError)
{
    <div class="toast error">@reservationError</div>
}

<div class="content-banner">
    <span><strong>@Model.Reservas.Count(r => r.Estado == "Confirmada" || r.Estado == "EnCurso") reservas activas</strong><small>Revisa llegadas, pagos y disponibilidad desde una sola
        vista.</small></span>
        <a class="primary-button" href="#nueva-reserva" data-modal-open="reservation-modal">＋ Nueva reserva</a>
    </div>
    <section class="table-card">
        <div class="table-head">
            <div>
                <h2>Próximas reservas</h2>
                <p>Consulta el estado de cada estadía.</p>
            </div>
            <span class="eyebrow">Próximas estadías</span>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID reserva</th>
                    <th>Cliente</th>
                    <th>Habitación</th>
                    <th>Estadía</th>
                    <th>Estado</th>
                    <th>Check-in</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Reservas)
                {
                    <tr>
                        <td><strong>#@item.IdReserva</strong></td>
                        <td>@item.Cliente</td>
                        <td>Hab. @item.Habitacion</td>
                        <td>@item.FechaInicio.ToString("dd MMM") — @item.FechaFin.ToString("dd MMM")</td>
                        <td><span class="payment @(item.Estado == "Confirmada" ? "pending" : "")">@item.Estado</span></td>
                        <td>
                            @if (item.Estado == "Confirmada")
                            {
                                <form method="post" asp-page-handler="CheckIn" class="checkin-form">
                                    <input type="hidden" name="id" value="@item.IdReserva" />
                                    <input name="documento" placeholder="Documento" aria-label="Documento del huésped" />
                                    <button class="secondary-button" type="submit">Check-in</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <div class="modal-backdrop" id="reservation-modal" aria-hidden="true" data-open-on-load="@(Model.ReabrirModal ? "true" : "false")">
        <section class="modal reservation-modal" role="dialog" aria-modal="true" aria-labelledby="reservation-title">
            <div class="modal-heading">
                <div><span class="eyebrow">Nueva reserva</span>
                    <h2 id="reservation-title">Registra una estadía</h2>
                    <p>Completa los datos del huésped y asigna una habitación.</p>
                </div>
                <button type="button" class="modal-close" data-modal-close aria-label="Cerrar">×</button>
            </div>
            <form method="post" asp-page-handler="CreateReservation" class="modal-form" novalidate>
                <div class="modal-main">
                    <div class="step-title"><b>1</b><span><strong>Datos del huésped</strong><small>Información principal de
                        contacto</small></span></div>
                        <div class="form-grid">
                                <label class="field@(Err("Reservation.GuestName"))"><span>Nombre completo</span><input asp-for="Reservation.GuestName" placeholder="Ej. Valentina Ríos" required /><small class="field-error">@Msg("Reservation.GuestName")</small></label>
                                <label class="field@(Err("Reservation.DocumentType"))"><span>Tipo de documento</span><select asp-for="Reservation.DocumentType"><option value="CC">CC</option><option value="CE">CE</option><option value="Pasaporte">Pasaporte</option></select><small class="field-error">@Msg("Reservation.DocumentType")</small></label>
                                <label class="field@(Err("Reservation.Document"))"><span>Documento</span><input asp-for="Reservation.Document" placeholder="Número de documento" required autocomplete="off" /><small class="field-error">@Msg("Reservation.Document")</small></label>
                                <label class="field@(Err("Reservation.Email"))"><span>Email</span><input asp-for="Reservation.Email" type="email" placeholder="nombre@email.com" required /><small class="field-error">@Msg("Reservation.Email")</small></label>
                                <label class="field@(Err("Reservation.Phone"))"><span>Teléfono</span><input asp-for="Reservation.Phone" placeholder="+57 300 000 0000" required /><small class="field-error">@Msg("Reservation.Phone")</small></label>
                            </div>
                            <div class="step-title"><b>2</b><span><strong>Fechas de estadía</strong><small>Define llegada, salida y
                                            ocupación</small></span></div>
                                            <div class="stay-grid">
                                                <label class="field"><span>Check-in</span><input asp-for="Reservation.CheckIn" type="date"
                                                                                                     value="@Model.Reservation.CheckIn.ToString("yyyy-MM-dd")" required /></label>
                                                    <label class="field"><span>Check-out</span><input asp-for="Reservation.CheckOut" type="date"
                                                                                                          value="@Model.Reservation.CheckOut.ToString("yyyy-MM-dd")" required /></label>
                                                        <label class="field"><span>Huéspedes</span><select asp-for="Reservation.Guests">
                                                            <option value="1">1 huésped</option>
                                                            <option value="2">2 huéspedes</option>
                                                            <option value="3">3 huéspedes</option>
                                                            <option value="4">4 huéspedes</option>
                                                        </select></label>
                                                    </div>
                                                    <div class="step-title"><b>3</b><span><strong>Selecciona una habitación</strong><small>Solo se muestran
                                                        habitaciones disponibles</small></span></div>
                                                        <div class="availability-alert" id="availability-alert" role="alert" hidden></div>
                                                        <div class="room-options" id="room-options" data-selected="@Model.Reservation.RoomNumber"><p class="availability-loading">Consultando disponibilidad…</p></div>
                                                                </div>
                                                                <aside class="reservation-summary">
                                                                    <span class="eyebrow">Resumen</span>
                                                                    <h3>Detalle de la reserva</h3>
                                                                    <div class="summary-room"><b id="summary-room-number">102</b><span><strong id="summary-room-type">Doble
                                                                        Clásica</strong><small><span id="summary-nights">3</span> noches · <span
                                                                        id="summary-guests">2</span> huéspedes</small></span></div>
                                                                        <div class="summary-dates"><span>Llegada<strong id="summary-checkin">12 Jun 2026</strong><small>Desde
                                                                            las 3:00 PM</small></span><b>›</b><span>Salida<strong id="summary-checkout">15 Jun
                                                                            2026</strong><small>Hasta las 12:00 PM</small></span></div>
                                                                            <div class="summary-line"><span>Alojamiento (<span id="summary-nights-label">3</span> noches)</span><b
                                                                                id="summary-subtotal">$555.000</b></div>
                                                                                <div class="summary-line"><span>IVA (19%)</span><b id="summary-tax">$105.450</b></div>
                                                                                <div class="summary-total"><span>Total estimado<small>Pesos colombianos</small></span><b
                                                                                    id="summary-total">$660.450 <small>COP</small></b></div>
                                                                                    <div class="summary-note">♢ Cancelación gratuita hasta 24 horas antes del check-in.</div>
                                                                                </aside>
                                                                                <label class="field privacy@(Err("Reservation.AcceptPrivacy"))"><span><input asp-for="Reservation.AcceptPrivacy" type="checkbox" /> Acepto la política de privacidad y el tratamiento de datos personales</span><small class="field-error">@Msg("Reservation.AcceptPrivacy")</small></label>
                                                                                <div class="modal-actions"><button type="button" class="secondary-button"
                                                                                                                       data-modal-close>Cancelar</button><button class="primary-button" type="submit">✓ Confirmar
                                                                                    reserva</button></div>
                                                                                </form>
                                                                            </section>
                                                                        </div>
