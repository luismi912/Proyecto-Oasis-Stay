<mxfile host="app.diagrams.net"><diagram id="maq-hotel" name="Máquina de estados de la habitación"><mxGraphModel dx="1704" dy="1302" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2200" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="e101" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=15;fontColor=#1a5fb4;" value="Máquina de estados UML — Habitación (patrón State, IEstadoHabitacion)" vertex="1"><mxGeometry x="0" y="-40" width="900" height="26" as="geometry" /></mxCell><mxCell id="e102" parent="1" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" value="" vertex="1"><mxGeometry x="492" y="0" width="16" height="16" as="geometry" /></mxCell><mxCell id="e103" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Disponible&lt;/b&gt;&lt;br&gt;do / se ofrece en la búsqueda de disponibilidad" vertex="1"><mxGeometry x="380" y="60" width="240" height="80" as="geometry" /></mxCell><mxCell id="e104" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Reservada&lt;/b&gt;&lt;br&gt;do / fechas bloqueadas para otras reservas (RN-01)" vertex="1"><mxGeometry x="900" y="60" width="240" height="80" as="geometry" /></mxCell><mxCell id="e105" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Ocupada&lt;/b&gt;&lt;br&gt;do / registrar consumos (minibar, late check-out)" vertex="1"><mxGeometry x="900" y="360" width="240" height="80" as="geometry" /></mxCell><mxCell id="e106" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b style=&quot;font-size:14px&quot;&gt;En limpieza&lt;/b&gt;&lt;br&gt;do / visible para el Ama de llaves" vertex="1"><mxGeometry x="380" y="360" width="240" height="80" as="geometry" /></mxCell><mxCell id="e107" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Mantenimiento&lt;/b&gt;&lt;br&gt;entry / guardar motivo&lt;br&gt;do / fuera de la oferta" vertex="1"><mxGeometry x="-60" y="60" width="240" height="80" as="geometry" /></mxCell><mxCell id="e108" edge="1" parent="1" source="e102" target="e103" style="html=1;rounded=0;strokeWidth=1.4;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=default;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e109" edge="1" parent="1" source="e103" target="e104" style="html=1;rounded=0;strokeWidth=1.4;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=default;verticalAlign=bottom;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" value="Reservar()&lt;br&gt;[reserva válida: fechas, capacidad RN-05&lt;br&gt;y sin solapamiento RN-01]&lt;br&gt;/ crear reserva"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e110" edge="1" parent="1" source="e104" target="e103" style="html=1;rounded=0;strokeWidth=1.4;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=default;verticalAlign=top;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" value="MarcarDisponible()&lt;br&gt;[cancelación, No-Show o reasignación]&lt;br&gt;/ liberar habitación"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e111" edge="1" parent="1" source="e104" target="e105" style="html=1;rounded=0;strokeWidth=1.4;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=default;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="HacerCheckIn()&lt;br&gt;[documento verificado y&lt;br&gt;fecha de llegada alcanzada]"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e112" edge="1" parent="1" source="e105" target="e106" style="html=1;rounded=0;strokeWidth=1.4;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=default;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" value="HacerCheckOut()&lt;br&gt;[saldo pendiente = 0]&lt;br&gt;/ emitir factura (CheckoutFacade)&lt;br&gt;y archivar reserva"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e113" edge="1" parent="1" source="e106" target="e103" style="html=1;rounded=0;strokeWidth=1.4;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=default;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" value="MarcarDisponible()&lt;br&gt;[rol = Ama de llaves]"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e114" edge="1" parent="1" source="e103" target="e107" style="html=1;rounded=0;strokeWidth=1.4;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=default;verticalAlign=bottom;exitX=0;exitY=0.25;entryX=1;entryY=0.25;" value="MarcarMantenimiento(motivo)&lt;br&gt;[motivo ≥ 10 caracteres]"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e115" edge="1" parent="1" source="e107" target="e103" style="html=1;rounded=0;strokeWidth=1.4;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=default;verticalAlign=top;exitX=1;exitY=0.75;entryX=0;entryY=0.75;" value="MarcarDisponible()"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e116" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff5f5;strokeColor=#c0504d;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;Transiciones rechazadas (flujos alternativos)&lt;/b&gt;&lt;br&gt;• Ocupada → Disponible: «La habitación está ocupada: requiere check-out previo» (US-02 ESC3)&lt;br&gt;• Disponible → Mantenimiento sin motivo: «Debe ingresar el motivo del mantenimiento (mínimo 10 caracteres)» (US-02 ESC2)&lt;br&gt;• En limpieza → Disponible por un rol distinto al Ama de llaves: 403&lt;br&gt;• Reservar en limpieza: «La habitación está en limpieza»&lt;br&gt;• Disponible → Ocupada (check-in sin reserva): no permitido&lt;br&gt;• Cualquier otra: «La operación no está permitida en estado {estado}»" vertex="1"><mxGeometry x="-60" y="520" width="1200" height="130" as="geometry" /></mxCell><mxCell id="e117" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=15;fontColor=#1a5fb4;" value="Matriz de análisis de estados y transiciones" vertex="1"><mxGeometry x="1260" y="-40" width="700" height="26" as="geometry" /></mxCell><mxCell id="e118" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f2f5;strokeColor=#b0b7c3;fontSize=11;fontStyle=1;align=left;spacingLeft=6;verticalAlign=middle;" value="Estado actual" vertex="1"><mxGeometry x="1260" y="0" width="100" height="30" as="geometry" /></mxCell><mxCell id="e119" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f2f5;strokeColor=#b0b7c3;fontSize=11;fontStyle=1;align=left;spacingLeft=6;verticalAlign=middle;" value="Evento" vertex="1"><mxGeometry x="1360" y="0" width="190" height="30" as="geometry" /></mxCell><mxCell id="e120" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f2f5;strokeColor=#b0b7c3;fontSize=11;fontStyle=1;align=left;spacingLeft=6;verticalAlign=middle;" value="Condición de guarda" vertex="1"><mxGeometry x="1550" y="0" width="250" height="30" as="geometry" /></mxCell><mxCell id="e121" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f2f5;strokeColor=#b0b7c3;fontSize=11;fontStyle=1;align=left;spacingLeft=6;verticalAlign=middle;" value="Acción" vertex="1"><mxGeometry x="1800" y="0" width="240" height="30" as="geometry" /></mxCell><mxCell id="e122" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f2f5;strokeColor=#b0b7c3;fontSize=11;fontStyle=1;align=left;spacingLeft=6;verticalAlign=middle;" value="Nuevo estado" vertex="1"><mxGeometry x="2040" y="0" width="110" height="30" as="geometry" /></mxCell><mxCell id="e123" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="Disponible" vertex="1"><mxGeometry x="1260" y="30" width="100" height="56" as="geometry" /></mxCell><mxCell id="e124" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;fontFamily=Courier New;" value="Reservar()" vertex="1"><mxGeometry x="1360" y="30" width="190" height="56" as="geometry" /></mxCell><mxCell id="e125" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="Reserva válida: fechas coherentes, capacidad (RN-05) y sin solapamiento (RN-01)" vertex="1"><mxGeometry x="1550" y="30" width="250" height="56" as="geometry" /></mxCell><mxCell id="e126" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="Crear la reserva y registrar el evento en el historial" vertex="1"><mxGeometry x="1800" y="30" width="240" height="56" as="geometry" /></mxCell><mxCell id="e127" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="Reservada" vertex="1"><mxGeometry x="2040" y="30" width="110" height="56" as="geometry" /></mxCell><mxCell id="e128" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="Disponible" vertex="1"><mxGeometry x="1260" y="86" width="100" height="44" as="geometry" /></mxCell><mxCell id="e129" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;fontFamily=Courier New;" value="MarcarMantenimiento(motivo)" vertex="1"><mxGeometry x="1360" y="86" width="190" height="44" as="geometry" /></mxCell><mxCell id="e130" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="Motivo de al menos 10 caracteres" vertex="1"><mxGeometry x="1550" y="86" width="250" height="44" as="geometry" /></mxCell><mxCell id="e131" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="Guardar el motivo" vertex="1"><mxGeometry x="1800" y="86" width="240" height="44" as="geometry" /></mxCell><mxCell id="e132" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="Mantenimiento" vertex="1"><mxGeometry x="2040" y="86" width="110" height="44" as="geometry" /></mxCell><mxCell id="e133" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="Reservada" vertex="1"><mxGeometry x="1260" y="130" width="100" height="44" as="geometry" /></mxCell><mxCell id="e134" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;fontFamily=Courier New;" value="HacerCheckIn()" vertex="1"><mxGeometry x="1360" y="130" width="190" height="44" as="geometry" /></mxCell><mxCell id="e135" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="Documento verificado y fecha de llegada alcanzada" vertex="1"><mxGeometry x="1550" y="130" width="250" height="44" as="geometry" /></mxCell><mxCell id="e136" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="Registrar el check-in en el historial" vertex="1"><mxGeometry x="1800" y="130" width="240" height="44" as="geometry" /></mxCell><mxCell id="e137" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="Ocupada" vertex="1"><mxGeometry x="2040" y="130" width="110" height="44" as="geometry" /></mxCell><mxCell id="e138" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="Reservada" vertex="1"><mxGeometry x="1260" y="174" width="100" height="72" as="geometry" /></mxCell><mxCell id="e139" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;fontFamily=Courier New;" value="MarcarDisponible()&lt;br&gt;&lt;span style=&quot;color:#666666;font-family:Helvetica;font-size:10px&quot;&gt;cancelación, No-Show o reasignación&lt;/span&gt;" vertex="1"><mxGeometry x="1360" y="174" width="190" height="72" as="geometry" /></mxCell><mxCell id="e140" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="Cancelación tardía (&lt; 24 h): se cobra la primera noche salvo exoneración del Administrador. No-Show: sin check-in al cierre del día de llegada" vertex="1"><mxGeometry x="1550" y="174" width="250" height="72" as="geometry" /></mxCell><mxCell id="e141" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="Liberar la habitación y registrar el evento" vertex="1"><mxGeometry x="1800" y="174" width="240" height="72" as="geometry" /></mxCell><mxCell id="e142" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="Disponible" vertex="1"><mxGeometry x="2040" y="174" width="110" height="72" as="geometry" /></mxCell><mxCell id="e143" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="Ocupada" vertex="1"><mxGeometry x="1260" y="246" width="100" height="56" as="geometry" /></mxCell><mxCell id="e144" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;fontFamily=Courier New;" value="HacerCheckOut()" vertex="1"><mxGeometry x="1360" y="246" width="190" height="56" as="geometry" /></mxCell><mxCell id="e145" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="Saldo pendiente igual a cero" vertex="1"><mxGeometry x="1550" y="246" width="250" height="56" as="geometry" /></mxCell><mxCell id="e146" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="Emitir la factura (CheckoutFacade) y archivar la reserva" vertex="1"><mxGeometry x="1800" y="246" width="240" height="56" as="geometry" /></mxCell><mxCell id="e147" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="En limpieza" vertex="1"><mxGeometry x="2040" y="246" width="110" height="56" as="geometry" /></mxCell><mxCell id="e148" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="En limpieza" vertex="1"><mxGeometry x="1260" y="302" width="100" height="44" as="geometry" /></mxCell><mxCell id="e149" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;fontFamily=Courier New;" value="MarcarDisponible()" vertex="1"><mxGeometry x="1360" y="302" width="190" height="44" as="geometry" /></mxCell><mxCell id="e150" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="El usuario tiene el rol Ama de llaves" vertex="1"><mxGeometry x="1550" y="302" width="250" height="44" as="geometry" /></mxCell><mxCell id="e151" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="Registrar el cambio de estado" vertex="1"><mxGeometry x="1800" y="302" width="240" height="44" as="geometry" /></mxCell><mxCell id="e152" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="Disponible" vertex="1"><mxGeometry x="2040" y="302" width="110" height="44" as="geometry" /></mxCell><mxCell id="e153" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="Mantenimiento" vertex="1"><mxGeometry x="1260" y="346" width="100" height="44" as="geometry" /></mxCell><mxCell id="e154" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;fontFamily=Courier New;" value="MarcarDisponible()" vertex="1"><mxGeometry x="1360" y="346" width="190" height="44" as="geometry" /></mxCell><mxCell id="e155" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="—" vertex="1"><mxGeometry x="1550" y="346" width="250" height="44" as="geometry" /></mxCell><mxCell id="e156" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="Registrar el cambio de estado" vertex="1"><mxGeometry x="1800" y="346" width="240" height="44" as="geometry" /></mxCell><mxCell id="e157" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b7c3;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=middle;" value="Disponible" vertex="1"><mxGeometry x="2040" y="346" width="110" height="44" as="geometry" /></mxCell><mxCell id="e158" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=15;fontColor=#1a5fb4;" value="Reglas de negocio" vertex="1"><mxGeometry x="1260" y="410" width="700" height="26" as="geometry" /></mxCell><mxCell id="e159" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" value="• Cinco estados válidos: Disponible, Reservada, Ocupada, En limpieza y Mantenimiento.&lt;br&gt;&lt;span style=&quot;color:#666666;font-size:11px&quot;&gt;&amp;nbsp;&amp;nbsp;Cada uno es una clase que implementa IEstadoHabitacion.&lt;/span&gt;&lt;br&gt;• Solo se reserva una habitación Disponible, con fechas válidas y sin solapamiento.&lt;br&gt;&lt;span style=&quot;color:#666666;font-size:11px&quot;&gt;&amp;nbsp;&amp;nbsp;ValidadorFechas, ValidadorCapacidad, ValidadorEstadoHabitacion y ValidadorSolapamiento (Chain of Responsibility).&lt;/span&gt;&lt;br&gt;• El check-in exige reserva previa y documento verificado.&lt;br&gt;&lt;span style=&quot;color:#666666;font-size:11px&quot;&gt;&amp;nbsp;&amp;nbsp;Desde Disponible el check-in se rechaza.&lt;/span&gt;&lt;br&gt;• El check-out exige saldo cero y deja la habitación En limpieza.&lt;br&gt;&lt;span style=&quot;color:#666666;font-size:11px&quot;&gt;&amp;nbsp;&amp;nbsp;CheckoutFacade cierra la cuenta, emite la factura y archiva la reserva en una transacción.&lt;/span&gt;&lt;br&gt;• Solo el Ama de llaves libera una habitación En limpieza.&lt;br&gt;&lt;span style=&quot;color:#666666;font-size:11px&quot;&gt;&amp;nbsp;&amp;nbsp;Otro rol recibe 403.&lt;/span&gt;&lt;br&gt;• Una habitación ocupada no se puede forzar a Disponible.&lt;br&gt;&lt;span style=&quot;color:#666666;font-size:11px&quot;&gt;&amp;nbsp;&amp;nbsp;EstadoOcupada rechaza la operación: requiere check-out previo.&lt;/span&gt;&lt;br&gt;• Mantenimiento exige motivo de al menos 10 caracteres.&lt;br&gt;&lt;span style=&quot;color:#666666;font-size:11px&quot;&gt;&amp;nbsp;&amp;nbsp;La habitación sale de la oferta hasta volver a Disponible.&lt;/span&gt;" vertex="1"><mxGeometry x="1260" y="442" width="890" height="300" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>